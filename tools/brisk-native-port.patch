diff --git a/src/dma3_manager.c b/src/dma3_manager.c
index 8ddc36f16..7d8178272 100644
--- a/src/dma3_manager.c
+++ b/src/dma3_manager.c
@@ -95,6 +95,17 @@ void ProcessDma3Requests(void)
 
 s16 RequestDma3Copy(const void *src, void *dest, u16 size, u32 mode)
 {
+#if BRISK_NATIVE
+    /* Desktop game callbacks run between complete host-rendered frames.
+     * Upload now: the cartridge queue can drop bursts of 128 requests or
+     * stall forever on a transfer above its 40 KiB VBlank budget, and a
+     * temporary tile buffer may be freed before the next host VBlank. */
+    if (size != 0) {
+        if (mode == 1) { Dma3CopyLarge32_(src, dest, size); }
+        else { Dma3CopyLarge16_(src, dest, size); }
+    }
+    return 0;
+#endif
     int cursor;
     int i = 0;
 
@@ -127,6 +138,17 @@ s16 RequestDma3Copy(const void *src, void *dest, u16 size, u32 mode)
 
 s16 RequestDma3Fill(s32 value, void *dest, u16 size, u32 mode)
 {
+#if BRISK_NATIVE
+    /* Desktop game callbacks run between complete host-rendered frames.
+     * Upload now: the cartridge queue can drop bursts of 128 requests or
+     * stall forever on a transfer above its 40 KiB VBlank budget, and a
+     * temporary tile buffer may be freed before the next host VBlank. */
+    if (size != 0) {
+        if (mode == 1) { Dma3FillLarge32_(value, dest, size); }
+        else { Dma3FillLarge16_(value, dest, size); }
+    }
+    return 0;
+#endif
     int cursor;
     int i = 0;
 
diff --git a/src/bg.c b/src/bg.c
index fdc777f8b..ea940a04a 100644
--- a/src/bg.c
+++ b/src/bg.c
@@ -1,5 +1,8 @@
 #include <limits.h>
 #include "global.h"
+#if BRISK_NATIVE
+#include "platform/transfer_bounds.h"
+#endif
 #include "bg.h"
 #include "dma3.h"
 #include "gpu_regs.h"
@@ -1202,10 +1205,17 @@ static u32 GetBgType(u32 bg)
 
 bool32 IsTileMapOutsideWram(u32 bg)
 {
+#if BRISK_NATIVE
+    /* Native graphics buffers live in the enlarged executable heap, not
+     * only in the cartridge's IWRAM/EWRAM address windows. Keep rejecting
+     * NULL, read-only data and unmapped pointers through the host bounds. */
+    return !transfer_bounds_ok((uintptr_t)sGpuBgConfigs2[bg].tilemap, 1, TRANSFER_WRITE);
+#else
     if (sGpuBgConfigs2[bg].tilemap > (void *)IWRAM_END)
         return TRUE;
     else if (sGpuBgConfigs2[bg].tilemap == NULL)
         return TRUE;
     else
         return FALSE;
+#endif
 }
