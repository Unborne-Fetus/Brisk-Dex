{
  "name": "brisk-dex",
  "productName": "Brisk Dex",
  "version": "1.2.0",
  "description": "Companion app for Pok\u00e9mon Brisk Emerald",
  "main": "main.js",
  "author": {
    "name": "Brisk Emerald",
    "email": "noreply@briskemerald.local"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "android:prepare": "node tools/prepare_android.mjs",
    "android:add": "npm run android:prepare && npx cap add android && node tools/patch_android.mjs",
    "android:sync": "npm run android:prepare && npx cap sync android && node tools/patch_android.mjs",
    "android:build": "npm run android:prepare && npx cap sync android && node tools/patch_android.mjs && cd android && ./gradlew assembleDebug",
    "ios:prepare": "node tools/prepare_android.mjs",
    "ios:add": "npm run ios:prepare && npx cap add ios",
    "ios:sync": "npm run ios:prepare && npx cap sync ios",
    "ios:build": "npm run ios:prepare && npx cap sync ios",
    "battle-server": "node battle-server.js",
    "battle:coverage": "node tools/check_battle_coverage.js",
    "battle:smoke": "node tools/test_battle_server.js",
    "web:build": "node tools/build_web.mjs",
    "index:build": "node tools/build_standalone.mjs",
    "game:dev": "node tools/serve_native_game.mjs",
    "game:test": "node --test test/game/*.test.mjs",
    "game:import-maps": "node tools/import_native_maps.mjs",
    "game:ui": "node tools/test_native_ui.cjs",
    "game:release": "node tools/build_native_release.mjs",
    "game:battle-build": "node tools/build_native_battle.mjs",
    "game:port": "python tools/port_native_content.py",
    "index:test": "npm run index:build && node tools/test_standalone_game.mjs",
    "game:field-data": "python tools/export_field_data.py",
    "game:ui:embedded": "node tools/test_embedded_game.cjs",
    "game:story-data": "python tools/export_story_data.py",
    "desktop:test": "node --test test/desktop/*.test.cjs",
    "desktop:ui": "node tools/test_desktop_game.cjs",
    "game:wild-sprites": "python tools/export_wild_sprites.py",
    "game:ui:battle": "node tools/test_battle_presentation.cjs",
    "game:ui:field": "node tools/test_field_presentation.cjs",
    "game:ui:features": "node tools/test_native_features.cjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "acorn": "^8.19.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.2"
  },
  "build": {
    "appId": "com.briskemerald.briskdex",
    "productName": "Brisk Dex",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "brisk-dex-data.json",
      "brisk-dex-trainer-teams.json",
      "brisk-dex-icons/**/*",
      "brisk-dex-trainers/**/*",
      "brisk-dex-items/**/*",
      "brisk-dex-trainer-pics/**/*",
      "brisk-dex-sprites/**/*",
      "brisk-dex-cries/**/*",
      "battle-server.js",
      "brisk-battle-effects.json",
      "localization.js",
      "translation-service.js",
      "asset-loader.js",
      "brisk-dex-asset-patches/**/*",
      "brisk-dex-icon-manifest.json",
      "game/**/*",
      "desktop-content.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
